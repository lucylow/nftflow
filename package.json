{
  "name": "nftflow-backend",
  "version": "1.0.0",
  "description": "NFTFlow backend services with event sourcing and blockchain integration",
  "main": "dist/server/api.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/api.js",
    "dev": "ts-node-dev --respawn --transpile-only server/api.ts",
    "event-ingest": "ts-node-dev --respawn --transpile-only services/event-ingest.ts",
    "worker": "ts-node-dev --respawn --transpile-only services/worker.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js"
  },
  "keywords": [
    "nft",
    "rental",
    "blockchain",
    "ethereum",
    "somnia",
    "event-sourcing"
  ],
  "author": "NFTFlow Team",
  "license": "MIT",
  "dependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomiclabs/hardhat-etherscan": "^3.1.0",
    "@openzeppelin/contracts": "^4.9.0",
    "arweave": "^1.14.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.1",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "ipfs-core": "^0.16.0",
    "nft.storage": "^7.0.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3",
    "rate-limit-redis": "^3.0.1",
    "viem": "^1.19.0",
    "web3.storage": "^5.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.5",
    "@types/pg": "^8.10.2",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "eslint": "^8.45.0",
    "jest": "^29.6.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nftflow/nftflow-backend.git"
  },
  "bugs": {
    "url": "https://github.com/nftflow/nftflow-backend/issues"
  },
  "homepage": "https://github.com/nftflow/nftflow-backend#readme"
}