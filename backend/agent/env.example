# Somnia RPC endpoint
SOMNIA_RPC=https://rpc.testnet.somnia.network

# Private key for signing transactions (NEVER commit this!)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_FOR_PROPOSER

# Deployed ArbitrageRouter contract address
ARBITRAGE_ROUTER=0xYourDeployedArbitrageRouterAddress

# Token addresses (use 0x0000000000000000000000000000000000000000 for native)
PROFIT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
BOND_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Bond amount in wei (1e15 = 0.001 ETH)
BOND_AMOUNT=1000000000000000

# Treasury address for profit distribution
TREASURY_ADDRESS=0xYourTreasuryAddress

# Minimum profit threshold in wei
MIN_PROFIT_WEI=1000000000000000

# Profit distribution shares (basis points, 10000 = 100%)
PROPOSER_SHARE_BPS=8000
TREASURY_SHARE_BPS=1500

# Server port
PORT=4011
